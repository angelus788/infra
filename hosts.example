# Copy this to `hosts` (gitignored) and fill in your real hosts.
# ansible_os_family is auto-detected via facts, so you don't need to declare
# OS anywhere here - it's just a normal inventory.

# Both plays in run.yml target [fleet]. The first play runs the SSH port
# juggling logic (tasks/ssh_juggle_port.yml): it tries ansible_port first,
# then falls back to 22 (and Raspberry Pi default creds) for brand-new hosts
# that haven't been hardened yet. It's a no-op once a host already answers
# on its configured port, so freshly-provisioned and already-hardened hosts
# can safely live in the same group.
[fleet]
ubuntu-box ansible_host=192.168.2.10 ansible_user=CHANGE_ME ansible_port=69
arch-box   ansible_host=192.168.2.11 ansible_user=CHANGE_ME ansible_port=69
fedora-box ansible_host=192.168.2.12 ansible_user=CHANGE_ME ansible_port=69

# If you have several keys loaded in your ssh-agent, uncomment this - without
# it, ssh offers every agent key before your intended one, which can exceed
# the server's MaxAuthTries and get you disconnected with "Too many
# authentication failures" (Ansible included, not just interactive ssh).
#[fleet:vars]
#ansible_ssh_common_args='-o IdentitiesOnly=yes -o IdentityFile=~/.ssh/id_ed25519'
